#!/usr/bin/env python3
"""plan: o que falta para fechar o tier, e qual e a proxima acao.

Uso:
  plan            tabela do tier, fase a fase, com o que falta
  plan --json     a mesma coisa em JSON

O painel da area mostra o que existe. Este comando mostra o buraco: as fases
que o tier exige e que ainda nao tem artefato nenhum. Sem ele, um projeto pela
metade parece completo, porque so o que existe aparece em algum lugar.
"""
import argparse
import json
import os
import sys
from pathlib import Path

sys.dont_write_bytecode = True
sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
import _kitlib as kit

PENDENTE = "pendente"
# SQ-01 exige approved. Contar superseded como fechado faria o plan
# sugerir uma fase que o gate-check recusaria em seguida.
FECHADO = ("approved",)


def levantamento(root, state):
    obrigatorias = kit.required_phases(state.get("tier"))
    gates = state.get("gates") or {}
    fases = []
    for slug in obrigatorias:
        gate = gates.get(slug) or {}
        fases.append({
            "slug": slug,
            "status": gate.get("status") or PENDENTE,
            "evidence": gate.get("evidence"),
            "by": gate.get("by"),
            "date": gate.get("date"),
        })
    return fases


def forca_da_evidencia(root, fase):
    """Quantos ponteiros de reconstrucao o artefato carrega."""
    if not fase.get("evidence"):
        return None
    artefato = Path(root) / fase["evidence"]
    if not artefato.exists():
        return None
    front, _ = kit.read_frontmatter(artefato)
    if front is None:
        return None
    return len(kit.ponteiros_de_evidencia(front))


def painel_reverso(root, state, fases):
    """No modo reverso a sessao abre pela duvida, nao pelos documentos.

    Vinte documentos em ordem numa sessao so e a receita da leitura diagonal.
    O que precisa do humano e o que o agente NAO achou, mais o que ele achou
    com pouca sustentacao. Esse e o comeco da lista.
    """
    print("Modo reverso: importacao em andamento.")
    print("Gate por fase esta suspenso. A confirmacao e em bloco, numa sessao.")
    print()

    sem_resposta = [q for q in (state.get("open_questions") or [])
                    if not (q or {}).get("answered")]
    print("1. Perguntas em aberto (%d). Comece por aqui: e o que o agente nao"
          % len(sem_resposta))
    print("   conseguiu recuperar com evidencia, e ninguem alem de voce pode.")
    for questao in sem_resposta:
        print("   - %s: %s" % (questao.get("id"), questao.get("question")))
    if not sem_resposta:
        print("   (nenhuma)")
    print()

    reconstruidas = [f for f in fases if f["status"] == "proposed"]
    fracas, fortes = [], []
    for fase in reconstruidas:
        (fortes if (forca_da_evidencia(root, fase) or 0) else fracas).append(fase)

    print("2. Reconstrucoes sem ponteiro de evidencia (%d). Nao da nem para"
          % len(fracas))
    print("   amostrar: confirm-import recusa enquanto existirem.")
    for fase in fracas:
        print("   - %-20s %s" % (fase["slug"], fase["evidence"] or ""))
    if not fracas:
        print("   (nenhuma)")
    print()

    print("3. Reconstrucoes com evidencia (%d). Amostre algumas e confira no"
          % len(fortes))
    print("   codigo. Confianca fundamentada vale mais que leitura completa.")
    for fase in fortes:
        quantos = forca_da_evidencia(root, fase) or 0
        print("   - %-20s %s (%d ponteiro(s))"
              % (fase["slug"], fase["evidence"] or "", quantos))
    if not fortes:
        print("   (nenhuma)")
    print()

    pendentes = [f for f in fases if f["status"] == PENDENTE]
    if pendentes:
        print("4. Fases que a reconstrucao nao alcancou (%d). Elas nao existem"
              % len(pendentes))
        print("   no projeto, e vao ser vividas no modo normal depois.")
        for fase in pendentes:
            print("   - %s" % fase["slug"])
        print()

    if fracas or sem_resposta:
        print("Proxima acao: rodar a sessao de confirmacao e resolver os itens")
        print("1 e 2. Depois: bin/lifecycle/confirm-import --by \"<seu nome>\"")
    else:
        print("Proxima acao: confirmar a importacao em bloco.")
        print('  bin/lifecycle/confirm-import --by "<seu nome>"')
    return 0


def proxima(fases):
    """Primeira fase que ainda nao esta fechada."""
    for fase in fases:
        if fase["status"] not in FECHADO:
            return fase
    return None


def main(argv=None):
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--json", action="store_true", dest="as_json")
    args = parser.parse_args(argv)

    root = kit.repo_root()
    try:
        state = kit.read_state(root)
    except ValueError as erro:
        kit.die("plan: %s" % erro, 1)

    if kit.required_phases(state.get("tier")) is None:
        kit.die("plan: tier nao declarado em docs/STATE.md (esta %r). Sem tier "
                "o kit nao sabe quais fases exigir. Preencha tier: 1, 2 ou 3. "
                "Ver docs/_process/tiers.md." % state.get("tier"), 1)

    fases = levantamento(root, state)
    faltam = [f for f in fases if f["status"] not in FECHADO]
    seguinte = proxima(fases)
    area = state.get("current_area") or "<area>"

    if args.as_json:
        print(json.dumps({
            "project": state.get("project"),
            "tier": state.get("tier"),
            "fases": fases,
            "faltam": len(faltam),
            "total": len(fases),
            "proxima": seguinte["slug"] if seguinte else None,
            "import_mode": state.get("import_mode"),
        }, ensure_ascii=False, indent=2))
        return 0

    print("Projeto: %s" % (state.get("project") or "(sem nome)"))
    print("Tier %s: %d fases obrigatorias, faltam %d de %d."
          % (state.get("tier"), len(fases), len(faltam), len(fases)))
    print()
    if kit.import_reverso(state):
        return painel_reverso(root, state, fases)
    largura = max(len(f["slug"]) for f in fases)
    for fase in fases:
        marca = " " if fase["status"] in FECHADO else ">"
        print("%s %-*s  %-12s %s" % (marca, largura, fase["slug"], fase["status"],
                                     fase["evidence"] or ""))
    print()
    if seguinte is None:
        print("Todas as fases obrigatorias do tier estao fechadas.")
        return 0

    if seguinte["status"] == PENDENTE:
        print("Proxima acao: criar o artefato da fase %s." % seguinte["slug"])
        entradas = ""
        anteriores = [f for f in fases
                      if f["evidence"] and kit.phase_number(f["slug"])
                      < kit.phase_number(seguinte["slug"])]
        if anteriores and seguinte["slug"] not in kit.PHASES_SEM_INPUTS:
            entradas = " --inputs %s" % anteriores[-1]["evidence"]
        print('  bin/lifecycle/new-artifact %s %s "<titulo>" --owner "<nome>"%s'
              % (seguinte["slug"], area, entradas))
    else:
        print("Proxima acao: fechar a fase %s, hoje em %s."
              % (seguinte["slug"], seguinte["status"]))
        alvo = seguinte["evidence"] or "o artefato"
        if seguinte["status"] == "superseded":
            # Mandar aprovar o artefato ja superado seria mandar aprovar o que
            # foi descartado. O gate precisa apontar para o substituto.
            fields, _ = kit.read_frontmatter(Path(root) / str(seguinte["evidence"]))
            novo_path = (fields or {}).get("superseded_by")
            print("  %s foi substituido por %s." % (alvo, novo_path or "outro artefato"))
            print("  aponte o evidence do gate em docs/STATE.md para o substituto "
                  "e aprove ele.")
        elif seguinte["status"] in ("draft", "in_progress"):
            print("  preencha %s e marque status: proposed." % alvo)
        else:
            print("  um humano aprova editando o frontmatter de %s e o gate em "
                  "docs/STATE.md." % alvo)
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
