#!/usr/bin/env python3
"""confirm-import: fecha a importacao em modo reverso, em bloco.

Uso:
  confirm-import --by "<seu nome>"     confirma e baixa o import_mode
  confirm-import --dry-run             mostra o que seria confirmado

Por que existe, se o kit se recusa a ter um bin/approve.

Gate no modo normal e gate no modo reverso sao atos diferentes com o mesmo
nome. No modo normal, aprovar e autorizar: o artefato e insumo da fase
seguinte, e aprovar cedo compromete o que vem depois. Faz sentido ser caro.
No modo reverso nada esta sendo autorizado. A decisao ja aconteceu, esta no
codigo, foi tomada antes de o kit existir. Aprovar ali e verificar uma
reconstrucao.

Exigir vinte autorizacoes para algo que ninguem esta autorizando e o desenho
que produz carimbo automatico, e um approved carimbado e pior que um proposed
honesto: mente para todo leitor futuro. Entao a deliberacao muda de
granularidade, nao de natureza. Continua sendo um ato humano, explicito e
unico, e continua sendo recusado se vier assinado por agente.

O que este comando NAO faz: aprovar fase que nasceu no modo normal. Ele so
toca gates de um projeto com import_mode reverse, e so enquanto ele valer.
"""
import argparse
import datetime
import os
import sys
from pathlib import Path

sys.dont_write_bytecode = True
sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
import _kitlib as kit


def pendencias(root, state):
    """O que impede a confirmacao. Lista vazia quer dizer pronto."""
    problemas = []
    for questao in state.get("open_questions") or []:
        if not (questao or {}).get("answered"):
            problemas.append(
                "open_question %s sem resposta: %s"
                % (questao.get("id"), questao.get("question")))
    for slug, gate in sorted((state.get("gates") or {}).items()):
        gate = gate or {}
        if gate.get("status") != "proposed":
            continue
        evidencia = gate.get("evidence")
        if not evidencia:
            problemas.append("gate %s esta proposed sem artefato" % slug)
            continue
        artefato = Path(root) / evidencia
        if not artefato.exists():
            problemas.append("artefato de %s nao existe: %s" % (slug, evidencia))
            continue
        front, info = kit.read_frontmatter(artefato)
        if front is None:
            problemas.append("frontmatter de %s ilegivel: %s" % (evidencia, info))
            continue
        if not kit.ponteiros_de_evidencia(front):
            problemas.append(
                "%s nao tem %s. Toda afirmacao reconstruida precisa apontar "
                "para o que a sustenta." % (evidencia, kit.CAMPO_EVIDENCIA))
    return problemas


def a_confirmar(state):
    return sorted(slug for slug, gate in (state.get("gates") or {}).items()
                  if (gate or {}).get("status") == "proposed")


def marca_artefato(path, nome, hoje):
    linhas = path.read_text(encoding="utf-8").splitlines()
    fim = None
    for indice, linha in enumerate(linhas[1:], start=1):
        if linha.strip() == "---":
            fim = indice
            break
    if fim is None:
        raise ValueError("frontmatter sem fechamento: %s" % path)
    for indice in range(1, fim):
        if linhas[indice].startswith("status:"):
            linhas[indice] = "status: approved"
        elif linhas[indice].startswith("approved_by:"):
            linhas[indice] = "approved_by: %s" % kit.emit_scalar(nome)
        elif linhas[indice].startswith("approved_at:"):
            linhas[indice] = "approved_at: %s" % hoje
    path.write_text("\n".join(linhas) + "\n", encoding="utf-8")


def main(argv=None):
    parser = argparse.ArgumentParser(add_help=True, description=__doc__)
    parser.add_argument("--by", help="quem confirma. Humano, sempre.")
    parser.add_argument("--dry-run", action="store_true", dest="dry_run")
    args = parser.parse_args(argv)

    root = kit.repo_root()
    try:
        state = kit.read_state(root)
    except ValueError as erro:
        kit.die("confirm-import: %s" % erro, 1)

    if not kit.import_reverso(state):
        kit.die("confirm-import: import_mode nao e reverse. Este comando so "
                "fecha importacao; gate de fase vivida se aprova a mao, como "
                "manda docs/_process/gates.md.", 1)

    alvos = a_confirmar(state)
    if not alvos:
        kit.die("confirm-import: nenhum gate em proposed para confirmar.", 1)

    problemas = pendencias(root, state)
    if problemas:
        print("confirm-import: a importacao ainda nao pode ser confirmada.\n")
        for item in problemas:
            print("  - %s" % item)
        print("\nA sessao de confirmacao existe para resolver exatamente isso.")
        return 1

    print("Gates que serao confirmados em bloco (%d):" % len(alvos))
    for slug in alvos:
        gate = state["gates"][slug]
        print("  %-20s %s" % (slug, gate.get("evidence")))
    if args.dry_run:
        print("\n--dry-run: nada foi escrito.")
        return 0

    if not args.by:
        kit.die("confirm-import: informe --by com o seu nome. Confirmar em "
                "bloco continua sendo um ato humano, explicito e assinado.", 1)
    nome = args.by.strip()
    if not nome:
        kit.die("confirm-import: --by vazio.", 1)
    if any(token in nome.lower() for token in kit.AGENT_TOKENS):
        kit.die("confirm-import: %r parece nome de agente. O principio 4 vale "
                "aqui igual: quem confirma e humano. Mudou a granularidade da "
                "aprovacao, nao quem aprova." % nome, 1)

    hoje = datetime.date.today().isoformat()
    for slug in alvos:
        gate = state["gates"][slug]
        marca_artefato(Path(root) / gate["evidence"], nome, hoje)
        gate.update({"status": "approved", "by": nome, "date": hoje,
                     "method": kit.METODO_BLOCO})
    state["import_mode"] = None
    kit.write_state(root, state)

    print("\n%d gates confirmados em bloco por %s em %s." % (len(alvos), nome, hoje))
    print("import_mode baixado: o projeto passa a viver no modo normal, e daqui")
    print("em diante gate se aprova um a um.")
    print("Commite a confirmacao. Ela e o registro de que isso aconteceu.")
    return 0


if __name__ == "__main__":
    sys.exit(main())
