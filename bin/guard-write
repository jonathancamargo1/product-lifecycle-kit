#!/usr/bin/env python3
"""guard-write: recusa a escrita num arquivo protegido.

Uso: guard-write <path>
Exit 0 liberado, exit 2 protegido, exit 1 erro de uso.

Inspeciona o arquivo como ele esta em disco, antes da escrita. O que e
protegido e o estado ja registrado, nunca o estado que se pretende gravar.
"""
import os
import sys

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
import _kitlib as kit

MENSAGEM = ("Arquivo protegido. Abra uma decisao (script decide) ou resolva a "
            "pendente.")


def main(argv=None):
    argv = list(sys.argv[1:] if argv is None else argv)
    if len(argv) != 1:
        kit.die("uso: guard-write <path>", 1)
    root = kit.repo_root()
    rel = kit.relative(root, argv[0])
    motivo = kit.blocking_reason(root, rel)
    if motivo is None:
        return 0
    sys.stderr.write("%s\n%s (%s)\n" % (MENSAGEM, rel, motivo))
    return 2


if __name__ == "__main__":
    raise SystemExit(main())
