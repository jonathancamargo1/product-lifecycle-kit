#!/usr/bin/env python3
"""product-lifecycle-kit: valida a mensagem de commit de sessao.

Mensagem que comeca com "sessao " precisa ser "sessao NN: <fase> <resumo>",
com NN igual ao session_counter de docs/STATE.md. Qualquer outra mensagem
passa sem validacao.
"""
import os
import re
import subprocess
import sys
from pathlib import Path


def repo_root():
    resultado = subprocess.run(["git", "rev-parse", "--show-toplevel"],
                               capture_output=True, text=True)
    if resultado.returncode != 0:
        raise SystemExit(0)
    return Path(resultado.stdout.strip())


def encadeia(root, argv):
    anterior = root / ".git" / "hooks" / "commit-msg.local"
    if anterior.exists() and os.access(anterior, os.X_OK):
        resultado = subprocess.run([str(anterior)] + argv)
        if resultado.returncode != 0:
            raise SystemExit(resultado.returncode)


SCISSORS = "# ------------------------ >8 ------------------------"


def corpo_da_mensagem(mensagem):
    """So o que o git vai guardar: sem comentario e sem o diff do commit -v."""
    linhas = []
    for linha in mensagem.splitlines():
        if linha.startswith(SCISSORS):
            break
        if linha.lstrip().startswith("#"):
            continue
        linhas.append(linha)
    return linhas


def _trailers(mensagem, marca):
    # Sem strip a esquerda: trailer de git vive na coluna 0, e o contador do
    # PH-01 usa git log --grep ancorado ali. Aceitar indentado aqui criaria uma
    # autorizacao que o contador nunca enxerga.
    return [l for l in corpo_da_mensagem(mensagem) if l.startswith(marca)]


PLACEHOLDER = "por que entra sem fase"


def autorizado(mensagem, marca):
    for linha in _trailers(mensagem, marca):
        motivo = linha.split(":", 1)[1].strip()
        if not motivo:
            continue
        # A linha sugerida pela propria recusa nao e autorizacao de ninguem.
        if PLACEHOLDER in motivo.lower():
            continue
        return True
    return False


def trailer_recusado(mensagem, marca):
    """Devolve o motivo da recusa do trailer, ou None se nao ha trailer."""
    for linha in _trailers(mensagem, marca):
        motivo = linha.split(":", 1)[1].strip()
        if not motivo:
            return "esta vazio"
        if PLACEHOLDER in motivo.lower():
            return ("ainda esta com o texto de exemplo desta mensagem. Ele nao "
                    "e autorizacao de ninguem")
    return None


def carrega_kit(root):
    # Sem isto o hook deixa __pycache__ dentro do projeto alvo a cada commit.
    # A instalacao manda rodar git add -A, entao o .pyc acaba versionado, e um
    # commit posterior que o reencene derruba o guard-commit.
    sys.dont_write_bytecode = True
    for dirname in ("bin/lifecycle", "bin"):
        lib = root / dirname / "_kitlib.py"
        if lib.exists():
            sys.path.insert(0, str(root / dirname))
            import _kitlib
            return _kitlib
    return None


def fase_para_codigo(root, mensagem):
    """None se pode commitar, ou o texto da recusa.

    Nao e bloqueio automatico: a recusa diz o que se perde e como prosseguir.
    Quem prossegue deixa a autorizacao registrada no proprio commit, para
    sempre, em vez de o desvio sumir em silencio.
    """
    kit = carrega_kit(root)
    if kit is None:
        return None
    # Um kit instalado antes desta regra nao tem estas funcoes. Degradar e
    # obrigatorio: install.sh reinstala os hooks mas preserva scripts que ja
    # existem, entao hook novo com lib antiga e um estado real, e nao pode
    # matar todo commit do projeto.
    for nome in ("is_code_path", "code_phase_open", "read_state", "CODE_TRAILER"):
        if not hasattr(kit, nome):
            return None
    try:
        state = kit.read_state(root)
    except (ValueError, TypeError):
        return None

    # O primeiro commit do repositorio esta importando o que ja existia, nao
    # escrevendo feature. A propria instalacao manda commitar tudo.
    if subprocess.run(["git", "rev-parse", "--verify", "HEAD"], cwd=str(root),
                      capture_output=True).returncode != 0:
        return None

    # Merge, rebase, cherry-pick e revert nao estao autorando codigo novo:
    # estao movendo commit que ja existe, e o staging carrega o diff inteiro.
    # O git-dir vem do git porque em worktree ligada .git e arquivo, nao pasta.
    gitdir = subprocess.run(["git", "rev-parse", "--absolute-git-dir"],
                            cwd=str(root), capture_output=True, text=True)
    if gitdir.returncode == 0 and gitdir.stdout.strip():
        g = Path(gitdir.stdout.strip())
        if any((g / nome).exists() for nome in
               ("MERGE_HEAD", "CHERRY_PICK_HEAD", "REVERT_HEAD",
                "rebase-merge", "rebase-apply")):
            return None

    # -z porque --name-only poe path nao ASCII entre aspas, e "docs/decisao.md"
    # com aspas deixa de casar com o prefixo docs/.
    # Sem text=True: nome de arquivo com byte nao UTF-8 levantaria
    # UnicodeDecodeError e bloquearia todo commit do repositorio.
    resultado = subprocess.run(
        ["git", "diff", "--cached", "--name-only", "-z",
         "--diff-filter=ACMRTD"],
        cwd=str(root), capture_output=True)
    if resultado.returncode != 0:
        return None
    bruto = resultado.stdout.decode("utf-8", "surrogateescape")
    codigo = [p for p in bruto.split("\0")
              if p and kit.is_code_path(p, root)]
    if not codigo:
        return None
    if kit.code_phase_open(state):
        return None

    if autorizado(mensagem, kit.CODE_TRAILER):
        return None
    recusado = trailer_recusado(mensagem, kit.CODE_TRAILER)
    if recusado:
        return ("commit-msg: %s %s.\n"
                "Pergunte ao humano e escreva a resposta dele, com nome:\n"
                "  %s hotfix de producao, autorizado por <nome da pessoa>\n"
                % (kit.CODE_TRAILER, recusado, kit.CODE_TRAILER))

    fase = state.get("current_phase") or "nenhuma"
    exemplo = codigo[0] if len(codigo) == 1 else "%s e mais %d" % (codigo[0],
                                                                  len(codigo) - 1)
    return (
        "commit-msg: codigo entrando sem fase de build aberta.\n"
        "\n"
        "  arquivos: %s\n"
        "  fase corrente: %s (codigo e esperado da 13-build-log em diante)\n"
        "\n"
        "O que se perde ao seguir assim: este codigo nao tem spec que o "
        "descreva,\nnao passa por review de papel distinto do executor, e nao "
        "deixa rastro\nde qual decisao de produto o originou. Daqui a tres "
        "meses ninguem sabe\npor que ele existe.\n"
        "\n"
        "O caminho recomendado, que diz qual e a proxima fase de verdade:\n"
        "  bin/lifecycle/plan\n"
        "\n"
        "Se mesmo assim este commit precisa entrar agora, pergunte ao humano e\n"
        "registre a resposta dele no proprio commit:\n"
        "  %s <por que entra sem fase, e quem autorizou>\n"
        "\n"
        "Nunca escreva esse trailer por conta propria. Ver AGENTS.md.\n"
        % (exemplo, fase, kit.CODE_TRAILER))


def session_counter(root):
    for dirname in ("bin/lifecycle", "bin"):
        lib = root / dirname / "_kitlib.py"
        if not lib.exists():
            continue
        sys.path.insert(0, str(root / dirname))
        import _kitlib as kit
        try:
            return int(kit.read_state(root).get("session_counter") or 0)
        except (ValueError, TypeError):
            return None
    return None


def main():
    argv = sys.argv[1:]
    if not argv:
        return 0
    root = repo_root()
    encadeia(root, argv)

    caminho = Path(argv[0])
    try:
        mensagem = caminho.read_text(encoding="utf-8")
    except OSError:
        return 0
    recusa = fase_para_codigo(root, mensagem)
    if recusa:
        sys.stderr.write(recusa)
        return 1

    primeira = mensagem.splitlines()[0] if mensagem.splitlines() else ""
    if not primeira.startswith("sessao "):
        return 0

    match = re.match(r"^sessao (\d{1,3}): (\S+) (.+)$", primeira)
    if not match:
        sys.stderr.write(
            "commit-msg: mensagem de sessao invalida.\n"
            "  esperado: sessao NN: <fase> <resumo>\n"
            "  recebido: %s\n" % primeira)
        return 1

    numero = int(match.group(1))
    contador = session_counter(root)
    if contador is not None and numero != contador:
        sys.stderr.write(
            "commit-msg: a mensagem diz sessao %d mas o session_counter em "
            "docs/STATE.md e %d.\n" % (numero, contador))
        return 1
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
